# =============================================================================
# Agentic AI-Powered Data Analyst - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# --- LLM Provider ---
# Supported: openai, azure, anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
DEBUG=true

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=csv,xlsx,xls

# --- Agent Limits ---
MAX_TOOL_CALLS_PER_QUESTION=5
MAX_RETRIES=2
MAX_ROWS=500000
REQUEST_TIMEOUT_SECONDS=120

# --- Storage ---
# For MVP: "sqlite" or "memory". Future: "postgresql"
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=./data/analyst.db
UPLOAD_DIR=./data/uploads

# --- PostgreSQL (optional, for production) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/analyst_db

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
